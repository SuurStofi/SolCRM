# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# SECRETS -- never commit these
.env
.env.local
.env.*.local
*.key

# Credential archives -- a zip of .env.local is still a secret.
*.env.zip
binance.env.zip
*.env.tar
*.env.tar.gz
secrets*.zip

# database (may contain trade history + Binance data)
/prisma/*.db
/prisma/*.db-journal
# local safety copies made before migrations -- same data as dev.db
/prisma/*.db.backup-*
*.sqlite
*.sqlite3

# typescript
*.tsbuildinfo

# vercel
.vercel
