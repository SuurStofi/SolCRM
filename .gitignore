# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# SECRETS -- never commit these
.env
.env.local
.env.*.local
*.key

# database (may contain trade history + Binance data)
/prisma/*.db
/prisma/*.db-journal
# local safety copies made before migrations -- same data as dev.db
/prisma/*.db.backup-*
*.sqlite
*.sqlite3

# typescript
*.tsbuildinfo

# vercel
.vercel

# Server credentials: SSH private key and host details. Never commit these.
/private/
*.pem
id_ed25519*
id_rsa*

# Credential archives -- a zip of .env.local is still a secret.
*.env.zip
binance.env.zip
*.env.tar
*.env.tar.gz
secrets*.zip

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Android signing material. The keystore IS the app's identity: anyone holding
# it plus the password can publish an update that installs over this app, so it
# never enters git. Back it up somewhere private -- losing it means future
# releases can no longer install over an existing install.
*.keystore
*.jks
/android/key.properties
/android/keystore.properties

# Android build output.
/android/build/
/android/app/build/
/android/.gradle/
/android/local.properties
/android/app/release/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json

# Local Android SDK (~500MB), downloaded by hand rather than installed
# system-wide. Reproducible from deploy/android/README.md, so it is not worth
# versioning.
/android-sdk/

# Local JDK 21, needed because @capacitor/android compiles at source level 21.
# Downloaded rather than installed system-wide; see deploy/android/README.md.
/build-tools-local/
