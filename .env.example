# Copy to .env.local and fill in. .env.local is gitignored -- never commit it.

# ---------------------------------------------------------------------------
# Binance API credentials
# ---------------------------------------------------------------------------
# Create at: https://www.binance.com/en/my/settings/api-management
#
# Enable ONLY these permissions:
#   [x] Enable Reading              -- balances, deposit history, deposit address
#   [x] Enable Spot & Margin Trading -- required for Convert (Phase 2) ONLY
#   [ ] Enable Withdrawals           -- LEAVE OFF. This app never withdraws.
#
# For Phase 1 (read-only dashboard) you can leave Spot & Margin Trading OFF too
# and switch it on when you reach Phase 2.
#
# Also restrict the key to your own IP address ("Restrict access to trusted IPs
# only") if you run this from a fixed location.
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ---------------------------------------------------------------------------
# Solana RPC
# ---------------------------------------------------------------------------
# Optional. Defaults to the public mainnet endpoint, which is heavily rate
# limited and will intermittently fail to load token accounts.
# A free Helius key (https://helius.dev) is strongly recommended:
#   https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# NOTE: NEXT_PUBLIC_ vars are exposed to the browser. That is fine for an RPC
# URL, but never put a Binance secret behind a NEXT_PUBLIC_ name.
NEXT_PUBLIC_SOLANA_RPC_URL=

# ---------------------------------------------------------------------------
# Local database (SQLite)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
