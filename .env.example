# Copy to .env.local and fill in. .env.local is gitignored -- never commit it.

# ---------------------------------------------------------------------------
# Encryption key for stored Binance credentials (REQUIRED)
# ---------------------------------------------------------------------------
# Each account links its own Binance API key in the app (Account panel). Those
# keys are stored encrypted with this value (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Back it up together with prisma/dev.db: losing or changing it makes every
# stored Binance key unreadable, and users have to paste theirs again.
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Solana RPC
# ---------------------------------------------------------------------------
# OPTIONAL - the app works with this left empty.
#
# Wallet RPC calls route through /api/solana/rpc, a server-side proxy. This is
# required, not an optimization: public endpoints return 403 "Access forbidden"
# to any browser request (one carrying an Origin header).
#
# To use a dedicated endpoint (e.g. Helius), prefer the SERVER-SIDE variable so
# the key never reaches the browser:
#   SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=

# Only for an endpoint that permits browser origins. NEXT_PUBLIC_ values are
# embedded in the client bundle, so never put a sensitive key here.
NEXT_PUBLIC_SOLANA_RPC_URL=

# ---------------------------------------------------------------------------
# Local database (SQLite)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./prisma/dev.db"

# ---------------------------------------------------------------------------
# BestChange (Exchanger and Compare tabs)
# ---------------------------------------------------------------------------
# OPTIONAL - without it the Exchanger tab explains how to connect and Compare
# shows Binance only.
#
# BestChange serves rates to partners only. Get a free key at
# https://www.bestchange.com/partner/ (Profile -> "API to get exchange rates").
# One key for the whole server; it is sent in the URL path, and is scrubbed
# from logs like the Binance secrets.
BESTCHANGE_API_KEY=

# ---------------------------------------------------------------------------
# Bank connections (optional, OFF by default)
# ---------------------------------------------------------------------------
# Monobank's personal API is meant for your OWN account. Running it for other
# people needs Monobank's Corporate API, which is requested from Monobank
# directly -- so this ships off and you switch it on deliberately.
#   https://api.monobank.ua/docs/
# Limits it enforces: one request per minute per token, and at most 31 days of
# statement per request. The app queues against both rather than retrying.
BANKS_MONOBANK_ENABLED=false

# Privat24 for Business (AutoClient) and personal statement import.
# Not implemented yet; the flag reserves the switch.
BANKS_PRIVAT_ENABLED=false

# How long bank transactions are kept before being purged, in days.
BANKS_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# PayPal via PYUSD on Solana (optional)
# ---------------------------------------------------------------------------
# No PayPal API is involved: PayPal publishes none for reading a consumer's
# balance or history, so this app never asks for a PayPal login. It only builds
# the on-chain half, which the user signs in their own wallet.
# PayPal crypto is not available in every country.
PAYPAL_PYUSD_ENABLED=false

# ---------------------------------------------------------------------------
# Price alerts (always on) and browser push (optional)
# ---------------------------------------------------------------------------
# Price alerts need no configuration and no Binance merchant status: they only
# read prices and write an in-app notification, which every account can see
# under the bell in the header.
#
# Browser push is an extra channel and is not implemented yet -- the sender is
# a deliberate no-op until per-device subscriptions are stored. Setting these
# alone does not start sending push. Generate a real pair with
# `npx web-push generate-vapid-keys` if you implement it; the values below are
# placeholders and must never be real keys in this file.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
