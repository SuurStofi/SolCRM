# Copy to .env.local and fill in. .env.local is gitignored -- never commit it.

# ---------------------------------------------------------------------------
# Encryption key for stored Binance credentials (REQUIRED)
# ---------------------------------------------------------------------------
# Each account links its own Binance API key in the app (Account panel). Those
# keys are stored encrypted with this value (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Back it up together with prisma/dev.db: losing or changing it makes every
# stored Binance key unreadable, and users have to paste theirs again.
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Solana RPC
# ---------------------------------------------------------------------------
# OPTIONAL - the app works with this left empty.
#
# Wallet RPC calls route through /api/solana/rpc, a server-side proxy. This is
# required, not an optimization: public endpoints return 403 "Access forbidden"
# to any browser request (one carrying an Origin header).
#
# To use a dedicated endpoint (e.g. Helius), prefer the SERVER-SIDE variable so
# the key never reaches the browser:
#   SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=

# Only for an endpoint that permits browser origins. NEXT_PUBLIC_ values are
# embedded in the client bundle, so never put a sensitive key here.
NEXT_PUBLIC_SOLANA_RPC_URL=

# ---------------------------------------------------------------------------
# Local database (SQLite)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./prisma/dev.db"

# ---------------------------------------------------------------------------
# BestChange (Exchanger and Compare tabs)
# ---------------------------------------------------------------------------
# OPTIONAL - without it the Exchanger tab explains how to connect and Compare
# shows Binance only.
#
# BestChange serves rates to partners only. Get a free key at
# https://www.bestchange.com/partner/ (Profile -> "API to get exchange rates").
# One key for the whole server; it is sent in the URL path, and is scrubbed
# from logs like the Binance secrets.
BESTCHANGE_API_KEY=
