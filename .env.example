# Copy to .env.local and fill in. .env.local is gitignored -- never commit it.

# ---------------------------------------------------------------------------
# Binance API credentials
# ---------------------------------------------------------------------------
# Create at: https://www.binance.com/en/my/settings/api-management
#
# Enable ONLY these permissions:
#   [x] Enable Reading              -- balances, deposit history, deposit address
#   [x] Enable Spot & Margin Trading -- required for Convert (Phase 2) ONLY
#   [ ] Enable Withdrawals           -- LEAVE OFF. This app never withdraws.
#
# For Phase 1 (read-only dashboard) you can leave Spot & Margin Trading OFF too
# and switch it on when you reach Phase 2.
#
# Also restrict the key to your own IP address ("Restrict access to trusted IPs
# only") if you run this from a fixed location.
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ---------------------------------------------------------------------------
# Solana RPC
# ---------------------------------------------------------------------------
# OPTIONAL - the app works with this left empty.
#
# Wallet RPC calls route through /api/solana/rpc, a server-side proxy. This is
# required, not an optimization: public endpoints return 403 "Access forbidden"
# to any browser request (one carrying an Origin header).
#
# To use a dedicated endpoint (e.g. Helius), prefer the SERVER-SIDE variable so
# the key never reaches the browser:
#   SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=

# Only for an endpoint that permits browser origins. NEXT_PUBLIC_ values are
# embedded in the client bundle, so never put a sensitive key here.
NEXT_PUBLIC_SOLANA_RPC_URL=

# ---------------------------------------------------------------------------
# Local database (SQLite)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./prisma/dev.db"
